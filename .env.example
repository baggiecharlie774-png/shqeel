# HyperNetwork — environment template.
# 1. Copy to .env.local:  cp .env.example .env.local
# 2. Fill in values from Supabase Dashboard → Project Settings → API
# 3. Restart the dev server. (.env.local is gitignored — never commit real keys.
#    For Vercel, add the same three vars in Project Settings → Environment Variables.)

# Supabase project URL, e.g. https://hypernetwork-app.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://hypernetwork-app.supabase.co

# Supabase "anon public" key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_ANON_KEY

# Supabase "service_role" key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_WITH_SERVICE_ROLE_KEY
